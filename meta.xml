<meta>
    <info author="hevesy.andras" type="script" name="tiktok"
          version="1.0.0"
          description="TikTok LIVE (@drandrew112) -> MTA events via a local Node.js bridge" />

    <!-- ui_core provides the client export addNotification(title, text) -->
    <include resource="ui_core" />

    <script src="shared/lists.lua"        type="shared" />

    <script src="server/config.lua"       type="server" />
    <script src="server/dispatch.lua"     type="server" />
    <script src="server/poller.lua"       type="server" />
    <script src="server/exports.lua"          type="server" />
    <script src="server/enemies.lua"          type="server" />
    <script src="server/enemy_cars.lua"       type="server" />
    <script src="server/actions.lua"          type="server" />
    <script src="server/gift_handler.lua"     type="server" />
    <script src="server/like_handler.lua"     type="server" />
    <script src="server/follower_handler.lua" type="server" />
    <script src="server/cleanup.lua"          type="server" />
    <script src="server/notify.lua"           type="server" />
    <script src="server/spawn_timers.lua"     type="server" />
    <script src="server/loadout.lua"          type="server" />
    <script src="server/example.lua"          type="server" />

    <script src="client/notify.lua"        type="client" />
    <script src="client/gift_effects.lua"  type="client" />
    <script src="client/enemy_ai.lua"      type="client" />
    <script src="client/enemy_car_ai.lua"  type="client" />
    <script src="client/hud_timers.lua"    type="client" />
    <script src="client/hud_legend.lua"    type="client" />
    <script src="client/train_control.lua" type="client" />

    <export function="isTikTokLive"    type="server" />
    <export function="getTikTokStatus" type="server" />

    <settings>
        <!-- Base URL of the Node.js bridge (no trailing slash needed). -->
        <setting name="*bridge_url"    value="http://127.0.0.1:8085" />
        <!-- Must match "sharedSecret" in bridge/config.json. -->
        <setting name="*bridge_secret" value="uAL1jmAksdWmc4Kl0Vg-XaCwuuJtZIpc" />
        <!-- Poll interval in milliseconds. -->
        <setting name="*poll_interval" value="1000" />
        <!-- "true" enables verbose server log output + the example.lua handlers. -->
        <setting name="*debug"         value="false" />
    </settings>

    <min_mta_version client="1.5.8-9.20998" server="1.5.4-9.11342" />
</meta>
